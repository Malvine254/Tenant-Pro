NODE_ENV=production
PORT=3000

# Public URLs
FRONTEND_URL=https://app.starmaxltd.com
CORS_ORIGINS=https://app.starmaxltd.com

# Prisma/MySQL
# For Docker Compose, docker-compose.prod.yml builds DATABASE_URL from the MYSQL_* values.
# For managed MySQL, set DATABASE_URL directly to mysql://USER:PASSWORD@HOST:3306/DB_NAME
DATABASE_URL=mysql://tenant_pro_user:change-me@mysql:3306/tenant_pro
MYSQL_DATABASE=tenant_pro
MYSQL_USER=tenant_pro_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
USE_JSON_DB=false

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_DELAY_SECONDS=60

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM_NAME=Starmax
MAIL_FROM_EMAIL=no-reply@starmaxltd.com

# M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_URL=https://app.starmaxltd.com/api/payments/mpesa/callback

# Optional seed accounts. Change before seeding production-like environments.
SEED_LANDLORD_PHONE=+254700000001
SEED_LANDLORD_EMAIL=landlord@example.com
SEED_LANDLORD_PASSWORD=change-me
SEED_ADMIN_PHONE=+254700000099
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_TENANT_PHONE=+254700000010
SEED_TENANT_EMAIL=tenant@example.com
SEED_TENANT_PASSWORD=change-me
SEED_CARETAKER_PHONE=+254700000020
SEED_CARETAKER_EMAIL=caretaker@example.com
SEED_CARETAKER_PASSWORD=change-me
