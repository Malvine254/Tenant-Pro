<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="32dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/primary" app:cardCornerRadius="26dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_quick_action">
                            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:layout_gravity="center" android:contentDescription="Rental home" android:src="@drawable/ic_apartment" android:tint="@color/on_primary" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Your rental overview" android:textColor="@color/on_primary" android:textSize="20sp" />
                            <TextView android:id="@+id/tvRentalPortfolioMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="No active units" android:textColor="#BFFFFFFF" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="#25FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" android:text="TOTAL OUTSTANDING" android:textColor="#BFFFFFFF" android:textSize="11sp" />
                    <TextView android:id="@+id/tvOutstandingValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:fontFamily="sans-serif-medium" android:text="KSh 0" android:textColor="@color/on_primary" android:textSize="28sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="96dp" android:layout_marginEnd="6dp" android:layout_weight="1" app:cardBackgroundColor="@color/info_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/info_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="ACTIVE" android:textColor="@color/info" android:textSize="11sp" />
                        <TextView android:id="@+id/tvRentalUnitsValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:fontFamily="sans-serif-medium" android:text="0" android:textColor="@color/on_surface" android:textSize="23sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="96dp" android:layout_marginHorizontal="6dp" android:layout_weight="1" app:cardBackgroundColor="@color/warning_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/warning_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="PENDING" android:textColor="@color/warning_variant" android:textSize="11sp" />
                        <TextView android:id="@+id/tvPendingValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:fontFamily="sans-serif-medium" android:text="0" android:textColor="@color/on_surface" android:textSize="23sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="96dp" android:layout_marginStart="6dp" android:layout_weight="1" app:cardBackgroundColor="@color/error_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/error_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="OVERDUE" android:textColor="@color/error_variant" android:textSize="11sp" />
                        <TextView android:id="@+id/tvOverdueValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:fontFamily="sans-serif-medium" android:text="0" android:textColor="@color/on_surface" android:textSize="23sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:fontFamily="sans-serif-medium" android:text="Your homes" android:textColor="@color/on_surface" android:textSize="19sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Unit and property details update automatically" android:textColor="@color/on_surface_variant" android:textSize="13sp" />
            <LinearLayout android:id="@+id/llRentalUnits" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" />
            <LinearLayout android:id="@+id/llRentalEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card_premium" android:gravity="center" android:orientation="vertical" android:padding="30dp" android:visibility="gone">
                <FrameLayout android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_icon_lavender">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:contentDescription="No rental" android:src="@drawable/ic_apartment" android:tint="@color/secondary" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif-medium" android:text="No rental assigned yet" android:textColor="@color/on_surface" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Once your landlord invites this account, your unit will connect and appear here automatically." android:textColor="@color/on_surface_variant" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressRental" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" app:indicatorColor="@color/secondary" app:trackThickness="3dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
