<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="PROFILE PHOTO" android:textColor="@color/primary" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Remove profile photo?" android:textColor="@color/on_surface" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your initials will be shown until you upload another profile photo." android:textColor="@color/on_surface_variant" android:textSize="13sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:background="@color/outline_variant" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKeepPhoto" style="@style/Theme.TenantPro.Button.Outlined" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Keep photo" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRemovePhoto" style="@style/Theme.TenantPro.Button.Primary" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Remove" />
    </LinearLayout>
</LinearLayout>
