<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/outline_variant" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="176dp">
            <ImageView android:id="@+id/ivRentalPropertyImage" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Property photo" android:scaleType="centerCrop" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#52071226" />
            <TextView android:id="@+id/tvRentalPropertyCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="14dp" android:background="@drawable/bg_badge_green" android:fontFamily="sans-serif-medium" android:paddingHorizontal="11dp" android:paddingVertical="6dp" android:textColor="@color/badge_green_text" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.textview.MaterialTextView android:id="@+id/tvRentalPropertyName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="@android:color/white" android:textSize="20sp" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/tvRentalPropertyMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="#D9FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llRentalPropertyUnits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
