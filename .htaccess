RewriteEngine On

# If a visitor reaches the internal Laravel public directory directly, send
# them to the equivalent clean public URL. THE_REQUEST is unchanged by the
# internal rewrite below, so this cannot create a redirect loop.
RewriteCond %{THE_REQUEST} \s/+laravel-app/public/([^?\s]*) [NC]
RewriteRule ^laravel-app/public/(.*)$ /$1 [R=301,L,NE]

# Keep Let's Encrypt validation working
RewriteRule ^\.well-known/ - [L]

# Proxy /rebuild and /rebuild/* to the Node.js rebuild tool on port 9090
# Requires mod_proxy and mod_proxy_http to be enabled on the server
RewriteRule ^rebuild/?(.*)$ http://127.0.0.1:9090/$1 [P,L,QSA,NC]

# Serve existing files/folders directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all app requests to Laravel public directory
RewriteCond %{REQUEST_URI} !^/laravel-app/public/
RewriteCond %{REQUEST_URI} !^/rebuild(/.*)?$
RewriteRule ^(.*)$ laravel-app/public/$1 [L]
