RewriteEngine On

# If a visitor reaches the internal Laravel public directory directly, send
# them to the equivalent clean public URL. THE_REQUEST is unchanged by the
# internal rewrite below, so this cannot create a redirect loop.
RewriteCond %{THE_REQUEST} \s/+laravel-app/public/([^?\s]*) [NC]
RewriteRule ^laravel-app/public/(.*)$ /$1 [R=301,L,NE]

# Keep Let's Encrypt validation working
RewriteRule ^\.well-known/ - [L]

# Proxy /rebuild and /rebuild/* to the Node.js rebuild tool on port 9090
# Requires mod_proxy and mod_proxy_http to be enabled on the server
RewriteRule ^rebuild/?(.*)$ http://127.0.0.1:9090/$1 [P,L,QSA,NC]

# Serve real static assets straight from the Laravel public folder (css, js,
# build output, images, favicon, robots.txt, etc.) without going through PHP.
# Anchored on DOCUMENT_ROOT so the check is correct no matter which nested
# .htaccess is active when Apache re-evaluates the rewritten path.
RewriteCond %{DOCUMENT_ROOT}/laravel-app/public/$1 -f
RewriteRule ^(.*)$ laravel-app/public/$1 [L]

# Everything else — including the bare site root — goes through the Laravel
# front controller directly. Routing straight to index.php, instead of the
# public/ directory, avoids depending on the host's DirectoryIndex setting;
# some shared-hosting vhosts returned 403 for "/" because of that.
RewriteRule ^ laravel-app/public/index.php [L]
